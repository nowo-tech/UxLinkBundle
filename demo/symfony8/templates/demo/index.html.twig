{% extends 'base.html.twig' %}

{% block title %}UX Link Bundle Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'UX Link Bundle Demo', intro: demoLabel ~ ' + FrankenPHP — contact, share, map, and download link components.'}) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card" id="contact-whatsapp">
        <div class="nowo-ui-card__body">
            <h2 class="nowo-ui-card__title">Contact — WhatsApp</h2>
            <twig:UxLink
                family="contact"
                provider="whatsapp"
                recipient="+34600111222"
                message="Hello from the UX Link demo"
            />
        </div>
    </section>

    <section class="nowo-ui-card" id="share-links">
        <div class="nowo-ui-card__body">
            <h2 class="nowo-ui-card__title">Share links</h2>
            <twig:UxShareLinks
                url="https://example.com/article"
                title="UX Link Bundle"
                text="Check out this Symfony bundle"
                :providers="['linkedin', 'x', 'whatsapp', 'telegram', 'email']"
            />
        </div>
    </section>

    <section class="nowo-ui-card" id="map-link">
        <div class="nowo-ui-card__body">
            <h2 class="nowo-ui-card__title">Map — OpenStreetMap</h2>
            <twig:UxLink
                family="map"
                provider="openstreetmap"
                :options="{ address: 'Madrid, Spain', label: 'Open in OpenStreetMap' }"
            />
        </div>
    </section>

    <section class="nowo-ui-card" id="download-link">
        <div class="nowo-ui-card__body">
            <h2 class="nowo-ui-card__title">Download</h2>
            <twig:UxDownloadLink
                url="https://example.com/sample.pdf"
                filename="sample.pdf"
                mimeType="application/pdf"
                :size="204800"
                label="Download sample PDF"
                description="Example enriched download card from the demo."
            />
        </div>
    </section>
{% endblock %}

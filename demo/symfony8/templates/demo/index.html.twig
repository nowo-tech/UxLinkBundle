{% extends 'base.html.twig' %}

{% block title %}UX Link Bundle Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'UX Link Bundle Demo', intro: demoLabel ~ ' + FrankenPHP — contact, share, map, and download link components.'}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Contact — WhatsApp', kind: 'content', testid: 'contact-whatsapp'} %}
        {% block section_body %}
            <twig:UxLink
                family="contact"
                provider="whatsapp"
                recipient="+34600111222"
                message="Hello from the UX Link demo"
            />
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Share links', kind: 'content', testid: 'share-links'} %}
        {% block section_body %}
            <twig:UxShareLinks
                url="https://example.com/article"
                title="UX Link Bundle"
                text="Check out this Symfony bundle"
                :providers="['linkedin', 'x', 'whatsapp', 'telegram', 'email']"
            />
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Map — OpenStreetMap', kind: 'content', testid: 'map-link'} %}
        {% block section_body %}
            <twig:UxLink
                family="map"
                provider="openstreetmap"
                :options="{ address: 'Madrid, Spain', label: 'Open in OpenStreetMap' }"
            />
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Download', kind: 'content', testid: 'download-link'} %}
        {% block section_body %}
            <twig:UxDownloadLink
                url="https://example.com/sample.pdf"
                filename="sample.pdf"
                mimeType="application/pdf"
                :size="204800"
                label="Download sample PDF"
                description="Example enriched download card from the demo."
            />
        {% endblock %}
    {% endembed %}
{% endblock %}

{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The light/dark toggle is UiKit's. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}UX Link Bundle Demo{% endblock %}{% endblock %}

{% block nowo_ui_head %}
    {#- the bundle's own share-links markup has no UiKit equivalent: a few layout rules, `var(--nowo-ui-*)` only -#}
    <link rel="stylesheet" href="{{ asset('demo.css') }}">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% endblock %}
{% endblock %}

{% block nowo_ui_navigation %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">UxLinkBundle</a>
        <nav class="nowo-ui-menu" aria-label="UxLinkBundle">
            <a class="nowo-ui-link" href="{{ path('demo_home') }}" aria-current="page">Link components</a>
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
